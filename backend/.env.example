NODE_ENV=development
PORT=5000

DATABASE_URL="postgresql://username:password@localhost:5432/database_name?schema=public&options=-c%20timezone%3DUTC"

JWT_SECRET=your_jwt_secret_key
JWT_EXPIRES_IN=1d

JWT_EMAIL_VERIFY_SECRET=your_jwt_email_verify_secret_key
JWT_EMAIL_VERIFY_EXPIRES_IN=1d

JWT_PASSWORD_RESET_SECRET=your_jwt_password_reset_secret_key
JWT_PASSWORD_RESET_EXPIRES_IN=15m

SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
SMTP_SECURE=true
RESEND_FROM=your_resend_from_email
RESEND_TO=your_resend_to_email

CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

CORS_ORIGIN=http://localhost:3000

COOKIE_SECRET=your_cookie_secret_key